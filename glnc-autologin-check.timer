[Unit]
Description=Periodically check GLNC authentication state

[Timer]
# NM 不会因校园网关撤销 Portal 认证而必然发送 up/dhcp4-change，故需要主动巡检。
# 按分钟定时巡检，即使上一轮探测/登录失败也会继续尝试。
# oneshot service 同时只运行一个实例，进程锁还可避免和 NM dispatcher 并发。
OnBootSec=30s
OnCalendar=minutely
Persistent=true
AccuracySec=5s
Unit=glnc-autologin-check.service

[Install]
WantedBy=timers.target
